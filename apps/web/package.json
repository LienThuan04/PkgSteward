{
  "name": "@pkgsteward/web",
  "version": "0.1.0",
  "description": "Web UI for PkgSteward - local manager for Node.js projects and their npm / pnpm / Yarn packages",
  "author": {
    "name": "LianHarman (LienThuan04)",
    "email": "lienthuan2004@gmail.com",
    "url": "https://github.com/LienThuan04"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LienThuan04/PkgSteward.git",
    "directory": "apps/web"
  },
  "bugs": {
    "url": "https://github.com/LienThuan04/PkgSteward/issues"
  },
  "homepage": "https://github.com/LienThuan04/PkgSteward#readme",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/run-next.mjs dev",
    "build": "next build",
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/run-next.mjs start",
    "test": "node --test \"lib/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "lint": "eslint",
    "theme:check": "node scripts/check-theme-contrast.mjs",
    "i18n:check": "node scripts/check-messages.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  }
}
